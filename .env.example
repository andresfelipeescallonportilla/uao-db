# Copia este archivo como .env.local y ajusta los valores.

# Cadena de conexión a tu PostgreSQL local (el mismo servidor que ves en pgAdmin 4).
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
# Si la contraseña tiene caracteres especiales (@ : / # ?), codifícalos (p. ej. @ -> %40).
DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/uao_db

# Esquema donde están las tablas (por defecto: public).
# DATABASE_SCHEMA=public

# Un servidor local normalmente no usa SSL. Pon "true" solo si tu servidor lo requiere.
# DATABASE_SSL=false
